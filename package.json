{
  "name": "dsh-superagent-dingtalk",
  "description": "Direct DingTalk Source for dsh-superagent: one Stream-mode connection per configured robot feeds robot messages into the engine pipeline; replies go back via the OpenAPI as the originating bot.",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Shuai-S",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "icon": "icon.svg",
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "node --test test/*.test.mjs",
    "prepare": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.2-rc.1",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "dependencies": {
    "dingtalk-stream": "^2.1.6-beta.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.20.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.25.12"
  }
}
